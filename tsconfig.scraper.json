{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist/scraper",
    "rootDir": "."
  },
  "include": ["scripts/scraper/**/*.ts"],
  "exclude": ["node_modules"]
}
